{
  "manifest_version": 3,
  "name": "Gentool Paper Prompt Crawler",
  "version": "0.1.0",
  "description": "Crawl open paper metadata/full-text snippets and export AI image-generation prompts.",
  "action": {
    "default_title": "Gentool",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["downloads", "storage", "sidePanel", "tabs"],
  "host_permissions": [
    "https://api.openalex.org/*",
    "https://www.ebi.ac.uk/europepmc/*"
  ]
}
