{
    "action":  {
                   "default_title":  "ChatGPT Automation - Auto ChatGPT on chatgpt.com"
               },
    "author":  {
                   "email":  "kylenguyenaws@gmail.com"
               },
    "background":  {
                       "service_worker":  "service-worker-loader.js",
                       "type":  "module"
                   },
    "content_scripts":  [
                            {
                                "all_frames":  false,
                                "js":  [
                                           "assets/index.ts-BIWZKm7r.js"
                                       ],
                                "matches":  [
                                                "*://chatgpt.com/*"
                                            ],
                                "run_at":  "document_end"
                            }
                        ],
    "description":  "Local modified ChatGPT Automation with longer timeout and independent-screen image downloads.",
    "host_permissions":  [
                             "*://chatgpt.com/*"
                         ],
    "icons":  {
                  "128":  "src/assets/logo.png",
                  "16":  "src/assets/logo.png",
                  "24":  "src/assets/logo.png",
                  "32":  "src/assets/logo.png"
              },
    "manifest_version":  3,
    "name":  "ChatGPT Automation - Timeout Extended",
    "offline_enabled":  true,
    "permissions":  [
                        "storage",
                        "tabs",
                        "background",
                        "sidePanel",
                        "activeTab",
                        "downloads"
                    ],
    "side_panel":  {
                       "default_path":  "src/ui/side-panel/index.html"
                   },
    "version":  "1.1.3.0",
    "version_name":  "1.1.3-local-timeout-independent-screens",
    "web_accessible_resources":  [
                                     {
                                         "matches":  [
                                                         "*://chatgpt.com/*"
                                                     ],
                                         "resources":  [
                                                           "assets/index.ts-BIWZKm7r.js"
                                                       ],
                                         "use_dynamic_url":  false
                                     }
                                 ]
}
